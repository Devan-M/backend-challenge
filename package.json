{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "db:migrate": "bun run src/migrate.ts up",
    "db:rollback": "bun run src/migrate.ts down",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/postgresql": "^6.4.16",
    "@mikro-orm/nestjs": "^6.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@aws-sdk/client-sqs": "^3.750.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.2",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}